      "rows_affected": 7032,
      "before": "Colonne stockée en texte (string) mais numérique à 100.0%.",
      "after": "Convertie en Float64.",
      "rationale": "Un montant stocké en texte ne peut être ni sommé ni moyenné par le KPI Agent.",
      "source_issue_id": null
    },
